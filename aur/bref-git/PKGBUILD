# Maintainer: Andrea Larboullet Marin <a.larboulletmarin@gmail.com>
# Tracks the main branch: every `makepkg -si` builds the latest commit.
pkgname=bref-git
_name=bref
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Fast, minimal Markdown note-taking app (development version)"
arch=('x86_64' 'aarch64')
url="https://github.com/alarboulletmarin/bref"
license=('MIT')
depends=('libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader')
makedepends=('cargo' 'git' 'fontconfig' 'freetype2')
optdepends=('vulkan-driver: a Vulkan driver for your GPU is required to open the window')
# The binary is stripped at build time: a -debug package would be empty, and its
# file would clash between bref and bref-git.
options=('!debug')
provides=('bref')
# The app was called encre until 0.1.4.
conflicts=('bref' 'encre' 'encre-git')
replaces=('encre-git')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    # Before the first tag there is nothing to describe: count commits instead.
    if git describe --long --tags >/dev/null 2>&1; then
        git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

prepare() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_name"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$_name"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
